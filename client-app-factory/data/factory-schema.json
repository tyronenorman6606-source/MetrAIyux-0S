{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sovereign Client App Factory Record",
  "type": "object",
  "required": [
    "clientId",
    "displayName",
    "industry",
    "contacts",
    "locations",
    "services",
    "sourceUrls",
    "sourceFolders",
    "assetFolders",
    "logoAssets",
    "mediaAssets",
    "publicRoutes",
    "privateRoutes",
    "workspacePlan",
    "trialUsage",
    "paymentPlan",
    "deploymentTargets",
    "proofArtifacts",
    "mcpReceipts",
    "scannerReports",
    "status"
  ],
  "properties": {
    "clientId": { "type": "string" },
    "displayName": { "type": "string" },
    "industry": { "type": "string" },
    "contacts": { "type": "array", "items": { "type": "object" } },
    "locations": { "type": "array", "items": { "type": "object" } },
    "services": { "type": "array", "items": { "type": "string" } },
    "sourceUrls": { "type": "array", "items": { "type": "string" } },
    "sourceFolders": { "type": "array", "items": { "type": "string" } },
    "assetFolders": { "type": "array", "items": { "type": "string" } },
    "logoAssets": { "type": "array", "items": { "type": "string" } },
    "mediaAssets": { "type": "array", "items": { "type": "string" } },
    "publicRoutes": { "type": "array", "items": { "type": "string" } },
    "privateRoutes": { "type": "array", "items": { "type": "string" } },
    "workspacePlan": { "type": "object" },
    "trialUsage": { "type": "object" },
    "paymentPlan": { "type": "object" },
    "deploymentTargets": { "type": "array", "items": { "type": "object" } },
    "proofArtifacts": { "type": "array", "items": { "type": "string" } },
    "mcpReceipts": { "type": "array", "items": { "type": "string" } },
    "scannerReports": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string" }
  }
}
