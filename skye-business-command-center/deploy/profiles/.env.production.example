# Production profile for one dedicated client instance.
# Copy to .env and replace every CHANGE_ME value before launch.
PROJECT_NAME=sbcc-client-slug
PUBLIC_BRAND_NAME=Client Business Command Center
PUBLIC_COMPANY_NAME=Client Company Name
PUBLIC_SUPPORT_EMAIL=support@client-domain.com
PUBLIC_SALES_EMAIL=sales@client-domain.com
PUBLIC_PHONE=CHANGE_ME
PUBLIC_DOMAIN=ops.client-domain.com
TZ=America/Los_Angeles
HUB_PORT=8080
HUB_BIND_ADDRESS=0.0.0.0
INTERNAL_BIND_ADDRESS=127.0.0.1
FREESCOUT_PORT=8081
ESPOCRM_PORT=8082
INVOICESHELF_PORT=8083
FORMBRICKS_PORT=8084
INVOICESHELF_APP_NAME=Client_Billing
FREESCOUT_DB_PASSWORD=CHANGE_ME_32_PLUS_CHARS
ESPOCRM_DB_PASSWORD=CHANGE_ME_32_PLUS_CHARS
INVOICESHELF_DB_PASSWORD=CHANGE_ME_32_PLUS_CHARS
FORMBRICKS_DB_PASSWORD=CHANGE_ME_32_PLUS_CHARS
REDIS_PASSWORD=CHANGE_ME_32_PLUS_CHARS
FREESCOUT_ADMIN_PASSWORD=CHANGE_ME_32_PLUS_CHARS
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=CHANGE_ME_32_PLUS_CHARS
INVOICESHELF_APP_KEY=base64:CHANGE_ME_VALID_LARAVEL_KEY
FORMBRICKS_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MINIMUM
FORMBRICKS_NEXTAUTH_SECRET=CHANGE_ME_32_PLUS_CHARS
FORMBRICKS_CRON_SECRET=CHANGE_ME_32_PLUS_CHARS
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=support@client-domain.com
SMTP_ENCRYPTION=tls
HUB_HOST=ops.client-domain.com
FREESCOUT_HOST=support.client-domain.com
ESPOCRM_HOST=crm.client-domain.com
INVOICESHELF_HOST=billing.client-domain.com
FORMBRICKS_HOST=forms.client-domain.com
FREESCOUT_PUBLIC_URL=https://support.client-domain.com
ESPOCRM_PUBLIC_URL=https://crm.client-domain.com
INVOICESHELF_PUBLIC_URL=https://billing.client-domain.com
FORMBRICKS_PUBLIC_URL=https://forms.client-domain.com
APP_TRUSTED_HOSTS=support.client-domain.com,forms.client-domain.com,localhost


# Local site brain
LOCAL_BRAIN_ENABLED=true
BRAIN_SERVICE_PORT=8099
# Supported providers: none, ollama, openai.
LOCAL_LLM_PROVIDER=none
OPENAI_API_KEY=CHANGE_ME_IF_USING_OPENAI
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Use LOCAL_LLM_PROVIDER=ollama only after your local/GPU Ollama endpoint is reachable.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct
