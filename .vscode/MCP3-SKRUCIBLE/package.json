{
  "name": "skrucible",
  "version": "1.0.3",
  "type": "module",
  "description": "SKRUCIBLE MCP by SkyesOverLondon — Design rendering OS and MCP server. React Three Fiber, GLSL shaders, Rapier physics, Tone.js audio. Connect to Claude or Cursor via npx skrucible.",
  "bin": {
    "skrucible": "./stdio-server.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node stdio-server.mjs",
    "start:http": "node http-server.mjs",
    "build:worker": "vite build && node remote/build-remote-bundle.mjs",
    "deploy": "npm run build:worker && npx wrangler pages deploy dist --project-name skrucible"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.6.5",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@react-spring/three": "^9.7.4",
    "@react-three/drei": "^9.111.3",
    "@react-three/fiber": "^8.17.6",
    "@react-three/postprocessing": "^2.16.2",
    "@react-three/rapier": "^1.5.0",
    "@theatre/core": "^0.7.2",
    "@use-gesture/react": "^10.3.1",
    "animejs": "^3.2.2",
    "framer-motion": "^11.5.4",
    "gsap": "^3.12.5",
    "lenis": "^1.1.14",
    "lucide-react": "^0.417.0",
    "maath": "^0.10.8",
    "motion": "^11.5.4",
    "pixi.js": "^7.4.2",
    "postprocessing": "^6.36.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.168.0",
    "tone": "^15.1.22",
    "zod": "^4.1.12",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.23.0",
    "vite": "^5.4.1"
  }
}
