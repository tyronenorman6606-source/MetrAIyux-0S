# ==========================================================
# Zoho Command Center environment variables
# Full plain-English explanation: docs/ENVIRONMENT.md
# Refresh-token walkthrough: docs/ZOHO_OAUTH_REFRESH_TOKEN.md
# ==========================================================

# ----------------------------------------------------------
# Neon / Postgres
# ----------------------------------------------------------
# Required if you want onboarding, clients, orders, billing items,
# mailbox inventory, and provisioning queue storage.
# Get it from Neon -> Project -> Connection string.
DATABASE_URL=""

# ----------------------------------------------------------
# Zoho OAuth app credentials
# ----------------------------------------------------------
# Required for all live Zoho API features.
# Get these from Zoho API Console / Developer Console after creating
# a server-based OAuth client.
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""

# Required for all live Zoho API features.
# Generate once through Zoho OAuth consent + token exchange.
# See docs/ZOHO_OAUTH_REFRESH_TOKEN.md.
ZOHO_REFRESH_TOKEN=""

# ----------------------------------------------------------
# Zoho data center base URLs
# ----------------------------------------------------------
# Change these if your Zoho account is not in the US data center.
# US: accounts.zoho.com + mail.zoho.com
# EU: accounts.zoho.eu + mail.zoho.eu
# IN: accounts.zoho.in + mail.zoho.in
# AU: accounts.zoho.com.au + mail.zoho.com.au, if applicable to your Zoho account
ZOHO_ACCOUNTS_BASE="https://accounts.zoho.com"
ZOHO_MAIL_BASE="https://mail.zoho.com"

# ----------------------------------------------------------
# Zoho Mail account/sender
# ----------------------------------------------------------
# Optional. If blank, the app pulls the first authenticated Zoho Mail account.
# You can get this after OAuth works by calling the Zoho accounts endpoint.
ZOHO_ACCOUNT_ID=""

# Recommended. Must be a real Zoho mailbox or an alias/send-as address
# allowed for the authenticated mailbox.
ZOHO_DEFAULT_FROM="support@your-platform-domain.com"
ZOHO_DEFAULT_FROM_NAME="Support"

# ----------------------------------------------------------
# Branding
# ----------------------------------------------------------
# Cosmetic only. Does not affect Zoho or Neon.
DASHBOARD_BRAND_NAME="Command Center"
DASHBOARD_ACCENT="Executive Ops"

# ----------------------------------------------------------
# Email-service product settings
# ----------------------------------------------------------
# Needed for the shared/platform lane.
# Use a domain you control and have configured in Zoho.
PLATFORM_EMAIL_DOMAIN="your-platform-domain.com"

# Needed only for admin/provisioning APIs such as creating domains,
# users, aliases, groups, and mailbox provisioning.
# Leave blank during basic inbox/send testing.
ZOHO_ORG_ID=""

# Recommended for POST /api/provisioning/run.
# You make this up. Use a long random value.
# Example generator: openssl rand -hex 32
PROVISIONING_RUN_SECRET=""
