# VantaCore Environment Variables Example
# Copy this file to .env and fill in the values
# VantaCore by Skyes Over London
#
# Legend:
#   [BUILD]  = Required at build time ( Next.js `next build`, CI pipeline )
#   [RUNTIME]= Required when the app server starts ( API routes, SSR, Edge )
#   [OPTIONAL]= Not required; feature is disabled if omitted
#   [CRIT]   = Critical: app will refuse to start in production if missing
#
# --- Core ---
DATABASE_URL="postgres://user:password@localhost:5432/vanta"           # [BUILD][RUNTIME][CRIT]
NEXT_PUBLIC_APP_URL="http://localhost:3000"                            # [BUILD][RUNTIME][CRIT]
NODE_ENV="development"                                                 # [BUILD][RUNTIME]

# --- 0S / FS27 Ownership Gate [RUNTIME][CRIT for production] ---
# Production must use FS27 introspection. Local tests may set FS27_GATE_MODE=local-bypass on localhost only.
FS27_GATE_MODE="enforced"                                              # enforced | local-bypass
FS27_INTROSPECTION_URL=""                                              # alias supported: SKYEGATE_INTROSPECT_URL, METRAIYUX_0S_SKYGATE_FS27_INTROSPECT_ENDPOINT
FS27_REQUIRED_SCOPES="gateway.read"
FS27_EVENT_ENDPOINT=""                                                 # alias supported: METRAIYUX_0S_SKYGATE_FS27_EVENT_ENDPOINT
FS27_EVENT_SECRET=""                                                   # alias supported: SKYGATEFS27_EVENT_MIRROR_SECRET, SKYGATE_EVENT_MIRROR_SECRET
VANTACORE_FS27_TENANT_MAP_JSON=""                                      # {"fs27_customer_id":"vanta_tenant_uuid"} when IDs differ

# --- VantaCore Twilio Integration (Voice & SMS) [OPTIONAL] ---
TWILIO_ACCOUNT_SID=""        # [RUNTIME]  Required if voice/SMS enabled
TWILIO_AUTH_TOKEN=""         # [RUNTIME]  Required for inbound webhook verification
TWILIO_PHONE_NUMBER=""       # [RUNTIME]  Required for outbound voice/SMS

# --- VantaCore Stripe Integration (Billing) [OPTIONAL] ---
STRIPE_PUBLISHABLE_KEY=""    # [BUILD]    Embedded in client bundles
STRIPE_SECRET_KEY=""         # [RUNTIME]  Required for billing API + webhooks
STRIPE_WEBHOOK_SECRET=""     # [RUNTIME]  Required to verify Stripe webhook signatures

# --- 0S / SkyePay Deposits [OPTIONAL] ---
VANTACORE_PAYMENT_MODE="disabled"                                      # disabled | mock(local only) | skypay
SKYPAY_BASE_URL=""                                                     # alias supported: SKYGATEFS27_WORKER_URL, SKYEGATE_FS27_URL
VANTACORE_SKYPAY_DEPOSIT_OFFER_ID=""
VANTACORE_SKYPAY_CLIENT_SLUG="metraiyux-0s"

# --- VantaCore Resend Integration (Email) [OPTIONAL] ---
RESEND_API_KEY=""            # [RUNTIME]  Required for transactional email
RESEND_WEBHOOK_SECRET=""     # [RUNTIME]  Required to verify Resend webhook signatures
RESEND_FROM_EMAIL=""

# --- Message and Webhook Modes [RUNTIME] ---
VANTACORE_MESSAGING_MODE="disabled"                                    # disabled | mock(local only) | live
VANTACORE_WEBHOOK_MODE="signed"                                        # signed | local-bypass(local only)

# --- VantaCore VANTA13 AI Provider (At least one required for AI features) [OPTIONAL] ---
OPENAI_API_KEY=""            # [RUNTIME]
ANTHROPIC_API_KEY=""         # [RUNTIME]
VANTA13_CLOUDFLARE_WORKER_URL=""                                      # preferred 0S-owned classifier endpoint
VANTA13_MODE=""                                                       # deterministic/mock for local-only fallback
VANTA13_OPENAI_MODEL=""                                               # required only when using direct OpenAI fallback

# --- VantaCore Storage (Optional - choose S3 or R2) [OPTIONAL] ---
# Media ingestion / quote photos / file uploads
VANTACORE_STORAGE_MODE="disabled"                                     # disabled | r2 | s3 | auto
# S3_BUCKET=""               # [RUNTIME]
# S3_REGION=""               # [RUNTIME]
# S3_ACCESS_KEY=""           # [RUNTIME]
# S3_SECRET_KEY=""           # [RUNTIME]
# CLOUDFLARE_R2_ACCOUNT_ID=""  # [RUNTIME]
# CLOUDFLARE_R2_ACCESS_KEY=""  # [RUNTIME]
# CLOUDFLARE_R2_SECRET_KEY=""  # [RUNTIME]
# CLOUDFLARE_R2_BUCKET_NAME="" # [RUNTIME]
# CLOUDFLARE_R2_PUBLIC_URL=""  # [BUILD]  Used for constructing public asset URLs

# --- VantaCore Google Calendar Integration (Optional) [OPTIONAL] ---
GOOGLE_CALENDAR_ID=""        # [RUNTIME]
GOOGLE_CLIENT_EMAIL=""       # [RUNTIME]
GOOGLE_PRIVATE_KEY=""        # [RUNTIME]

# --- VantaCore Auth (Optional - choose Clerk or Custom JWT) [OPTIONAL] ---
# CLERK_PUBLISHABLE_KEY=""   # [BUILD]
# CLERK_SECRET_KEY=""        # [RUNTIME]
# JWT_SECRET="min_32_characters_long_secret_key"  # [RUNTIME]

# --- VantaCore Analytics (Optional) [OPTIONAL] ---
# POSTHOG_API_KEY=""         # [RUNTIME]
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"  # [BUILD]

# --- VantaCore Observability / Alerts (Optional) [OPTIONAL] ---
# SENTRY_DSN=""              # [RUNTIME]
# LOG_LEVEL="info"           # [RUNTIME]  trace | debug | info | warn | error
# HEALTH_CHECK_SECRET=""     # [RUNTIME]  Bearer token for probing internal health endpoints
