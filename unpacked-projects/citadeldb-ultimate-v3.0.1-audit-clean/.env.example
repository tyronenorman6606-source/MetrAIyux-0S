# CitadelDB Ultimate

CITADEL_PROJECT_NAME=citadeldb
CITADEL_DOMAIN=citadeldb.internal
CITADEL_MODE=vps-postgres

# Primary Postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=citadel
POSTGRES_USER=citadel_admin
POSTGRES_PASSWORD=change-this-long-random-password

# PgBouncer
PGBOUNCER_PORT=6432
PGBOUNCER_AUTH_TYPE=scram-sha-256
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=30

# Gateway
GATEWAY_PORT=7313
GATEWAY_ADMIN_TOKEN=change-this-admin-token
GATEWAY_BIND_HOST=0.0.0.0

# App DB defaults
APP_DB_ROLE_PREFIX=app_
APP_DB_NAME_PREFIX=app_

# Backup / Reliquary
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_PASSWORD=change-this-encryption-password
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=12
BACKUP_STANZA=citadel
PGBACKREST_REPO_PATH=/var/lib/pgbackrest
PGBACKREST_RETENTION_FULL=2
PGBACKREST_RETENTION_DIFF=4

# Optional object storage
OBJECT_BACKUP_ENABLED=false
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
POSTGRES_EXPORTER_PORT=9187

# Upstream auth boundary
UPSTREAM_AUTH_MODE=token
TRUSTED_OPERATOR_HEADER=x-skyes-operator
REQUIRE_OPERATOR_HEADER=false

# SkyegateFS13 / FS27 auth and event bridge
SKYGATEFS13_URL=
SKYGATEFS13_INTROSPECT_PATH=/auth-introspect
SKYGATEFS13_AUTH_REQUIRED=false
SKYGATEFS13_DISABLE_LEGACY_ADMIN_TOKEN=false
SKYGATEFS13_EVENT_MIRROR_ENABLED=false
SKYGATEFS13_EVENT_PATH=/platform/events
SKYGATEFS13_EVENT_MIRROR_SECRET=
SKYGATEFS13_SOURCE_APP=citadeldb
SKYGATEFS13_TIMEOUT_MS=3500

# Optional AI debugging assistant
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DEBUG_MAX_CHARS=12000

# App credential generation
CITADEL_APP_PASSWORD_BYTES=32
APP_WRITE_SMOKE_TIMEOUT_MS=8000

# Operator experience
CITADEL_OPERATOR_MODE=guided
DIAGNOSTIC_BUNDLE_MAX_EVENTS=50

# Commercial control-plane / billing
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REQUIRE_ACTIVE_SUBSCRIPTION=false
UPSTREAM_ACCOUNT_HEADER=x-citadel-account
UPSTREAM_TEAM_HEADER=x-citadel-team

# Live gate hardening
ENFORCE_ENTITLEMENTS_ON_SELF_SERVICE=false
ENFORCE_UPSTREAM_TEAM_CONTEXT=false
USAGE_METERING_ENABLED=true
BRANCH_WORKER_ENABLED=false
