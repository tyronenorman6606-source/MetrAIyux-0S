# Reape0r environment template.
# Save as ~/.config/skyevault-agent/skyevault-agent.env and chmod 600.
# Do not commit this file after filling it in.

SKYEVAULT_DROP_URL=https://skyevault-drop.graylondonskyes.workers.dev
SKYEVAULT_WORKSPACE_ID=
SKYEVAULT_REPO_PATH=

# From the paid SkyePay install center.
SKYEVAULT_PORTAL_KEY=

# Customer-owned unlock passphrase. Store outside Git.
SKYEVAULT_AGENT_PASSPHRASE=

# Optional owner/admin hardening. This is the shared 0S/FS27/SkyGate bearer, not a SkyeVault password.
SKYEVAULT_GATE_BEARER=

SKYEVAULT_AGENT_INTERVAL_SECONDS=600

# Default model: mutable-current-mirror. No delta packs unless an operator explicitly runs sync --legacy-delta.
SKYEVAULT_AGENT_CUSTODY_MODEL=mutable-current-mirror
