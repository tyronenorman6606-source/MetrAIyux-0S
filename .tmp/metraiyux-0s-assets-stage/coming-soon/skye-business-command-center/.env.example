# =====================================================
# Skye Business Command Center environment template
# Copy to .env and edit before production.
# =====================================================

PROJECT_NAME=skye-business-command-center
PUBLIC_BRAND_NAME=Skye Business Command Center
PUBLIC_COMPANY_NAME=Skyes Over London
PUBLIC_SUPPORT_EMAIL=support@example.com
PUBLIC_SALES_EMAIL=sales@example.com
PUBLIC_PHONE=
PUBLIC_DOMAIN=localhost
TZ=America/Los_Angeles

# Hub
HUB_PORT=8080
HUB_BIND_ADDRESS=0.0.0.0
INTERNAL_BIND_ADDRESS=127.0.0.1

# Module ports
FREESCOUT_PORT=8081
ESPOCRM_PORT=8082
INVOICESHELF_PORT=8083
FORMBRICKS_PORT=8084
INVOICESHELF_APP_NAME=Skye_Billing

# Database passwords - run scripts/generate-secrets.sh to create a secrets.env helper.
FREESCOUT_DB_PASSWORD=change-me-freescout
ESPOCRM_DB_PASSWORD=change-me-espocrm
INVOICESHELF_DB_PASSWORD=change-me-invoiceshelf
FORMBRICKS_DB_PASSWORD=change-me-formbricks
REDIS_PASSWORD=change-me-redis
FREESCOUT_ADMIN_PASSWORD=change-me-admin
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=change-me-admin

# App secrets
INVOICESHELF_APP_KEY=base64:REPLACE_ME_WITH_INVOICESHELF_KEY
FORMBRICKS_ENCRYPTION_KEY=REPLACE_ME_32_CHAR_MINIMUM_SECRET
FORMBRICKS_NEXTAUTH_SECRET=REPLACE_ME_LONG_RANDOM_SECRET
FORMBRICKS_CRON_SECRET=REPLACE_ME_LONG_RANDOM_SECRET

# SMTP - required for serious production
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@example.com
SMTP_ENCRYPTION=tls

# Production domains, optional for reverse proxy
HUB_HOST=ops.example.com
FREESCOUT_HOST=support.example.com
ESPOCRM_HOST=crm.example.com
INVOICESHELF_HOST=billing.example.com
FORMBRICKS_HOST=forms.example.com
FREESCOUT_PUBLIC_URL=http://localhost:8081
ESPOCRM_PUBLIC_URL=http://localhost:8082
INVOICESHELF_PUBLIC_URL=http://localhost:8083
FORMBRICKS_PUBLIC_URL=http://localhost:8084
APP_TRUSTED_HOSTS=localhost,127.0.0.1,support.example.com,forms.example.com

# Storage note:
# For large videos/files, use Cloudflare R2 or S3-compatible storage at the app/module level.


# Local site brain
LOCAL_BRAIN_ENABLED=true
BRAIN_SERVICE_PORT=8099
# Supported providers: none, ollama, openai.
LOCAL_LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Use LOCAL_LLM_PROVIDER=ollama only after your local/GPU Ollama endpoint is reachable.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct
