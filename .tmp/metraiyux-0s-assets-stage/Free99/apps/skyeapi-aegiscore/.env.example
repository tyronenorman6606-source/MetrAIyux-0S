# SkyeAPI + AegisCore local mode
SKYEAPI_PROJECT_ID=proj_local_dev
SKYEAPI_VAULT_PATH=.aegiscore/vault.json
SKYEAPI_VAULT_PASSPHRASE=replace-with-a-local-passphrase-at-least-12-characters

# Hosted SkyeAPI gateway
SKYEAPI_BASE_URL=https://skyeapi-gateway.example.workers.dev
SKYEAPI_KEY=skye_live_replace_after_import_or_create_key
SKYE_ADMIN_KEY=replace-with-your-gateway-admin-key
AEGIS_MASTER_KEY=replace-with-at-least-32-random-characters-for-worker-secret
SKYE_ALLOWED_ORIGINS=http://localhost:4173,https://your-console-domain.example
SKYE_RATE_LIMIT_PER_MINUTE=120
SKYE_DEFAULT_PLAN=builder
# Optional JSON map for custom paid plans. Example: {"agency":{"dailyCallLimit":50000,"rateLimitPerMinute":1000,"allowedCapabilities":["*"]}}
SKYE_PLAN_CONFIG_JSON=

# Provider examples imported into AegisCore, not committed to git.
RESEND_API_KEY=re_xxx
RESEND_FROM=SkyeAPI <noreply@example.com>
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+15555555555
NEON_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
NEON_API_KEY=napi_xxx
NEON_PROJECT_ID=project-id
OPENAI_API_KEY=sk_xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
CLOUDFLARE_ACCOUNT_ID=account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=secret-key
CLOUDFLARE_R2_BUCKET=bucket-name

# v0.6 optional product-depth controls
# Fixture server is local CI only; not evidence of live provider success.
SKYEAPI_FIXTURE_PORT=8789
# Upstream-auth systems can send these headers into the Worker request path:
# x-skye-actor-id, x-skye-actor-email, x-skye-role, x-skye-project-role
