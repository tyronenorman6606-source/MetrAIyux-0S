{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doctor-ops.local/contracts/workspace-seed.schema.json",
  "title": "Doctor Ops Platform Workspace Seed",
  "type": "object",
  "required": ["workspace", "apps"],
  "properties": {
    "workspace": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "operator": {"type": "string"},
        "upstreamMode": {"type": "string", "enum": ["pass-through", "external-verified", "local-demo"]}
      },
      "additionalProperties": true
    },
    "apps": {
      "type": "object",
      "description": "Keys must match app slugs from assets/js/catalog.js. Each value may contain records, audit, versions, and receipts.",
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "type": "object",
          "properties": {
            "records": {"type": "array", "items": {"type": "object"}},
            "audit": {"type": "array", "items": {"type": "object"}},
            "versions": {"type": "array", "items": {"type": "object"}},
            "receipts": {"type": "array", "items": {"type": "object"}},
            "meta": {"type": "object"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
