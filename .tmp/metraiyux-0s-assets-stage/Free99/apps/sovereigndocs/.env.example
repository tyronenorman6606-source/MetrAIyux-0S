# SovereignDocs optional Node API mode
PORT=8787

# Optional: require this around future admin-only endpoints.
# Current build has no built-in auth and expects upstream identity headers.
SOVEREIGNDOCS_ADMIN_KEY=

# Upstream auth contract examples:
# x-sovereigndocs-user: {"id":"user_123","name":"Operator","organization":"Skyes Over London"}
# x-omega-skygate-user: {"id":"sky_123","name":"Operator","roles":["founder"]}
