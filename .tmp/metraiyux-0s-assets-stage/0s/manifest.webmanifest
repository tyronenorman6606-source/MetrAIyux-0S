{
  "name": "MetrAIyux 0S Launcher",
  "short_name": "0S Launcher",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "window-controls-overlay", "browser"],
  "background_color": "#03070b",
  "theme_color": "#03070b",
  "description": "A full-screen operating shell for the MetrAIyux 0S app ecosystem.",
  "icons": [
    {
      "src": "../assets/metraiyux-0s-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "../assets/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
