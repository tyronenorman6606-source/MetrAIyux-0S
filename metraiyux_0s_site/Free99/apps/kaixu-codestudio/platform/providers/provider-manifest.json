[
  {
    "id": "stripe",
    "title": "Stripe Payments",
    "lane": "payments",
    "enabled": false,
    "secretRef": "vault:stripe:primary",
    "requiredSecrets": [
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET"
    ],
    "routes": [
      "checkout.create",
      "invoice.send",
      "webhook.payment"
    ],
    "backend": "server/adapters/provider-registry.mjs#StripeAdapter"
  },
