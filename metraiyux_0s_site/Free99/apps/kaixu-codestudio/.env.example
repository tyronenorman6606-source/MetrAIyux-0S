# kAIxu CodeStudio Pro executable backend
# No login/auth is implemented here. Send upstream identity claims in x-kaixu-claims or request JSON.
PORT=7137
CODESTUDIO_PROVIDER_MODE=live
CODESTUDIO_RECEIPT_DIR=./receipts
CODESTUDIO_CORS_ORIGIN=*

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:7137/success
STRIPE_CANCEL_URL=http://localhost:7137/cancel

# Resend
RESEND_API_KEY=
RESEND_FROM=ops@skyesoverlondon.com

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# AI gateway / OpenAI fallback
KAIXU_GATEWAY_URL=
KAIXU_GATEWAY_SUBKEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Neon / Postgres
DATABASE_URL=
NEON_SQL_HTTP_URL=

# Netlify
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
NETLIFY_BUILD_HOOK_URL=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# Google service account operations
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CALENDAR_ID=primary

# Operator defaults
PARTNER_REVIEW_EMAIL=
OPERATOR_EMAIL=
# Durable platform state
CODESTUDIO_DATA_DIR=./data

# v5.8 engine hardening
# Set this to require signed upstream claims. Header format:
# x-kaixu-claims: base64url(JSON claims)
# x-kaixu-claims-ts: unix ms timestamp
# x-kaixu-claims-signature: HMAC-SHA256(base64url) over `${ts}.${claims}`
CODESTUDIO_UPSTREAM_CLAIMS_SECRET=
CODESTUDIO_REQUIRE_SIGNED_CLAIMS=0
CODESTUDIO_CLAIMS_MAX_AGE_MS=300000

# Generic webhook HMAC fallback. Provider-native secrets can also be used.
CODESTUDIO_WEBHOOK_SECRET=
CODESTUDIO_REQUIRE_WEBHOOK_SIGNATURES=0
CODESTUDIO_VERIFY_FIXTURE_WEBHOOKS=0

# Storage adapter selector. json is active in this portable package.
# sqlite/postgres/d1 contracts exist and intentionally block until driver/binding implementation is attached.
CODESTUDIO_STORAGE_ADAPTER=json
CODESTUDIO_SQLITE_PATH=./data/codestudio.sqlite

# Queue behavior
CODESTUDIO_JOB_LOCK_TTL_MS=300000
