  <style>
:root{
  --bg0:#fffaf0;
  --bg1:#fff2cc;
  --glass: rgba(255,255,255,.78);
  --stroke: rgba(120,90,20,.20);
  --text: rgba(18,18,18,.94);
  --muted: rgba(18,18,18,.68);
  --gold: #d4af37;
  --gold2:#b8860b;
  --danger: #b00020;
  --ok: #0a7a3d;
  --shadow: 0 18px 55px rgba(0,0,0,.12);
  --radius: 18px;
  --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  --sans: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
}


*{ box-sizing:border-box; }
html,body{ height:100%; }
html{
  max-width:100%;
  overflow-x:hidden;
}

body{
  margin:0;
  font-family: var(--sans);
  font-weight: 400;
  color: var(--text);
  background:
    radial-gradient(1200px 600px at 20% 10%, rgba(212,175,55,.22), transparent 60%),
    radial-gradient(900px 500px at 90% 30%, rgba(184,134,11,.16), transparent 55%),
    radial-gradient(1000px 600px at 50% 95%, rgba(212,175,55,.18), transparent 60%),
    linear-gradient(160deg, var(--bg0), var(--bg1));
  overflow-x:hidden;
}


a{ color: var(--gold2); text-decoration:none; }
a:hover{ text-decoration:underline; }

.wrap{
  min-height:100%;
  display:flex;
  flex-direction:column;
}

.topbar{
  position:sticky; top:0; z-index:10;
  backdrop-filter: blur(14px);
  background: rgba(255,255,255,.65);
  border-bottom: 1px solid rgba(120,90,20,.12);
}

.nav{
  max-width:1150px;
  margin:0 auto;
  padding:14px 16px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
  min-width:220px;
}
.brand img{
  width:42px;
  height:42px;
  object-fit:contain;
  filter: drop-shadow(0 0 16px rgba(212,175,55,.28)) drop-shadow(0 0 26px rgba(184,134,11,.18));
  animation: floatPulse 3.4s ease-in-out infinite;
}
@keyframes floatPulse{
  0%{ transform: translateY(0); filter: drop-shadow(0 0 12px rgba(212,175,55,.22)) drop-shadow(0 0 18px rgba(184,134,11,.16)); }
  50%{ transform: translateY(-4px); filter: drop-shadow(0 0 18px rgba(212,175,55,.36)) drop-shadow(0 0 30px rgba(184,134,11,.22)); }
  100%{ transform: translateY(0); filter: drop-shadow(0 0 12px rgba(212,175,55,.22)) drop-shadow(0 0 18px rgba(184,134,11,.16)); }
}
.brand .name{
  display:flex; flex-direction:column; line-height:1.1;
}
.brand .name b{ letter-spacing:.2px; }
.brand .name span{ font-size:12px; color:var(--muted); }

.navlinks{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  justify-content:flex-end;
}
.pill{
  padding:9px 12px;
  border:1px solid rgba(120,90,20,.22);
  background: rgba(255,255,255,.72);
  border-radius: 999px;
  color: var(--text);
  font-size:13px;
}
.pill:hover{ background: rgba(212,175,55,.14); }

.container{
  width:100%;
  max-width:1150px;
  margin:0 auto;
  padding-block:26px 30px;
  padding-inline:16px;
  flex:1;
}

.hero{
  display:grid;
  grid-template-columns: 1.2fr .8fr;
  gap:18px;
  align-items:stretch;
  padding-block:6px;
  padding-inline:0;
}
@media (max-width: 940px){
  .hero{ grid-template-columns:1fr; }
}

.card{
  background: var(--glass);
  border: 1px solid var(--stroke);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding:18px;
}

.h1{
  font-size: clamp(2.75rem, 5.4vw, 5.125rem);
  line-height:1.05;
  margin:0 0 10px;
  letter-spacing: .2px;
}
.sub{
  margin:0 0 18px;
  color: var(--muted);
  font-size:15px;
  line-height:1.6;
}

.grid2{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
@media (max-width: 720px){ .grid2{ grid-template-columns:1fr; } }

.kpi{
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.70);
  padding:12px;
}
.kpi b{ color: var(--gold); }
.kpi div{ font-size:12px; color:var(--muted); margin-top:6px; line-height:1.45; }

.btnrow{ display:flex; gap:10px; flex-wrap:wrap; margin-top:12px; }
.btn{
  cursor:pointer;
  padding:11px 14px;
  border-radius: 14px;
  border: 1px solid rgba(120,90,20,.24);
  background: rgba(255,255,255,.78);
  color: var(--text);
  font-weight: 700;
  letter-spacing:.2px;
}
.btn:hover{ background: rgba(212,175,55,.12); }
.btn.gold{
  border-color: rgba(212,175,55,.55);
  background: linear-gradient(135deg, rgba(212,175,55,.90), rgba(184,134,11,.78));
  color: rgba(18,18,18,.94);
}
.btn.danger{
  border-color: rgba(176,0,32,.40);
  background: rgba(176,0,32,.08);
}
.btn.ok{
  border-color: rgba(10,122,61,.40);
  background: rgba(10,122,61,.08);
}

.hr{ height:1px; background: rgba(120,90,20,.12); margin:14px 0; }

label{ font-size:12px; color: var(--muted); display:block; margin:10px 0 6px; }
input, textarea, select{
  width:100%;
  padding:12px 12px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.16);
  background: rgba(255,255,255,.76);
  color: var(--text);
  outline:none;
  font-size:14px;
}
textarea{ min-height: 120px; resize: vertical; }
small{ color: var(--muted); }

.badge{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:8px 10px;
  border-radius: 999px;
  border:1px solid rgba(120,90,20,.22);
  background: rgba(255,255,255,.70);
  font-size:12px;
  color: var(--muted);
}

.table{
  width:100%;
  border-collapse: collapse;
  overflow:hidden;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.14);
}
.table th, .table td{
  padding:12px 12px;
  border-bottom:1px solid rgba(255,255,255,.10);
  text-align:left;
  font-size:13px;
}
.table th{ color: var(--muted); font-weight:600; background: rgba(255,255,255,.72); }
.table tr:hover td{ background: rgba(212,175,55,.10); }
.table tr:last-child td{ border-bottom:none; }

.footer{
  border-top: 1px solid rgba(120,90,20,.12);
  background: rgba(255,255,255,.70);
}
.footer .container{ padding:18px 16px; }
.footer p{ margin:0; color: var(--muted); font-size:12px; line-height:1.6; }

.split{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
@media (max-width: 940px){ .split{ grid-template-columns:1fr; } }

.mono{ font-family: var(--mono); font-size: 12px; color: var(--muted); }

.notice{
  border:1px solid rgba(120,90,20,.18);
  background: rgba(255,255,255,.72);
  padding:12px;
  border-radius: 14px;
  color: var(--muted);
  line-height:1.55;
  font-size:13px;
}

.righthero{
  display:flex;
  flex-direction:column;
  gap:12px;
}
.heroimg{
  width:100%;
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,.14);
  overflow:hidden;
  background: rgba(255,255,255,.70);
}
.heroimg img{
  width:100%;
  display:block;
  object-fit:cover;
}
.tagline{
  font-size:13px;
  line-height:1.55;
  color: var(--muted);
}
.linksbox a{ display:inline-block; margin:6px 10px 0 0; }

.pane{
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.72);
  padding:12px;
}
.pane h3{ margin:0 0 8px; font-size:14px; color: var(--gold2); }
.pane .row{ display:flex; gap:10px; flex-wrap:wrap; }

.chatlog{
  max-height: 360px;
  overflow:auto;
  padding:10px;
  border-radius: 14px;
  border:1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.72);
}
.msg{
  padding:10px 10px;
  border-radius: 14px;
  border:1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.82);
  margin-bottom:10px;
}
.msg .role{ font-size:11px; color: var(--muted); }
.msg .content{ white-space:pre-wrap; font-size:13px; line-height:1.55; margin-top:4px; }

/* Customer-facing motion pass shared with marketing/suite. */
:root{
  --neon-bg:#05030b;
  --neon-ink:#fff8e7;
  --neon-muted:rgba(255,248,231,.76);
  --neon-line:rgba(97,246,255,.22);
  --neon-gold:#ffd76a;
  --neon-cyan:#61f6ff;
  --neon-pink:#ff4fd8;
}
html{scrollbar-width:thin;scrollbar-color:var(--neon-cyan) rgba(255,255,255,.08);}
::-webkit-scrollbar{width:14px;height:14px;}
::-webkit-scrollbar-track{background:rgba(255,255,255,.08);border-left:1px solid rgba(255,255,255,.1);}
::-webkit-scrollbar-thumb{min-height:72px;border:3px solid rgba(5,3,11,.92);border-radius:999px;background:linear-gradient(180deg,var(--neon-gold),var(--neon-cyan),var(--neon-pink));box-shadow:0 0 18px rgba(97,246,255,.42),inset 0 0 14px rgba(255,255,255,.18);}
body.motion-chrome{
  color:var(--neon-ink);
  background:
    linear-gradient(rgba(255,255,255,.026) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.026) 1px, transparent 1px),
    linear-gradient(140deg,#05030b 0%,#0b1014 42%,#1c0b19 100%);
  background-size:42px 42px,42px 42px,auto;
}
.scroll-progress{position:fixed;top:0;left:0;z-index:90;width:100%;height:4px;transform:scaleX(0);transform-origin:left center;background:linear-gradient(90deg,var(--neon-gold),var(--neon-cyan),var(--neon-pink));box-shadow:0 0 24px rgba(97,246,255,.48);}
.cursor-trail{position:fixed;top:0;left:0;z-index:70;width:240px;height:240px;border-radius:999px;pointer-events:none;mix-blend-mode:screen;background:radial-gradient(circle,rgba(97,246,255,.22),transparent 62%),radial-gradient(circle at 65% 38%,rgba(255,215,106,.18),transparent 58%),radial-gradient(circle at 34% 66%,rgba(255,79,216,.16),transparent 60%);filter:blur(3px);}
.scanline{position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.2;background:repeating-linear-gradient(180deg,rgba(255,255,255,.04) 0 1px,transparent 1px 5px);mix-blend-mode:screen;}
.topbar{background:rgba(5,3,11,.78);border-bottom-color:rgba(97,246,255,.18);}
.wrap,.container,.footer,.topbar{position:relative;z-index:2;}
.brand img{filter:drop-shadow(0 0 16px rgba(97,246,255,.28)) drop-shadow(0 0 22px rgba(255,215,106,.24));}
.brand .name span,.sub,.notice,.tagline,.kpi div,.footer,.footer a{color:var(--neon-muted);}
.pill,.btn,.card,.kpi,.badge,.notice,.table,input,textarea,select{border-color:var(--neon-line);background:linear-gradient(180deg,rgba(8,10,18,.78),rgba(6,8,14,.92));color:var(--neon-ink);box-shadow:0 18px 55px rgba(0,0,0,.28),0 0 26px rgba(97,246,255,.08);}
.btn.gold{color:#120b02;background:linear-gradient(135deg,var(--neon-gold),var(--neon-cyan));box-shadow:0 0 24px rgba(97,246,255,.28);}
.hero{position:relative;isolation:isolate;min-height:calc(100svh - 96px);align-items:center;}
.skymail-webgl{position:absolute;inset:0;z-index:-1;width:100%;height:100%;display:block;opacity:.76;}
.h1.glow-text{font-size:clamp(2.75rem,6.2vw,5.5rem);line-height:.96;color:var(--neon-ink);background:linear-gradient(90deg,#fff8e7 0%,var(--neon-gold) 28%,var(--neon-cyan) 58%,var(--neon-pink) 100%);-webkit-background-clip:text;background-clip:text;text-shadow:0 0 18px rgba(97,246,255,.18),0 0 30px rgba(255,215,106,.12);}
.mail-command-preview{display:grid;gap:12px;}
.mail-command-row{display:flex;justify-content:space-between;gap:14px;padding:13px;border:1px solid var(--neon-line);border-radius:12px;background:rgba(255,255,255,.055);}
.mail-command-row b,.mail-command-row span{display:block;}
.mail-command-row span{color:var(--neon-muted);font-size:13px;line-height:1.4;}
.skyemerit-card{margin-top:16px;padding:16px;border:1px solid rgba(255,255,255,.18);border-radius:12px;background:linear-gradient(135deg,rgba(228,184,78,.2),rgba(99,200,220,.12));}
.skyemerit-card b,.skyemerit-card span{display:block;}
.skyemerit-card span{color:var(--neon-muted);line-height:1.5;}
.spark-meter{height:10px;margin:12px 0;border:1px solid rgba(255,255,255,.18);border-radius:999px;overflow:hidden;background:rgba(0,0,0,.25);}
.spark-meter i{display:block;width:64%;height:100%;background:linear-gradient(90deg,#e4b84e,#63c8dc);}
.welcome-toast{position:fixed;right:18px;bottom:18px;z-index:40;max-width:340px;padding:16px;border:1px solid rgba(255,255,255,.22);border-radius:12px;background:rgba(7,9,13,.94);box-shadow:0 20px 80px rgba(0,0,0,.4);}
.welcome-toast[hidden]{display:none;}
.welcome-toast button{margin-top:10px;}
.status-light{width:11px;height:11px;border-radius:999px;background:var(--neon-cyan);box-shadow:0 0 18px rgba(97,246,255,.72);flex:0 0 auto;margin-top:4px;}
@media (pointer:coarse),(prefers-reduced-motion:reduce){.cursor-trail,.scanline{display:none}.skymail-webgl{opacity:.4}}
@media (max-width:700px){.mcp-neon-scroll-rail-x,.mcp-neon-scroll-corner{display:none!important}}
