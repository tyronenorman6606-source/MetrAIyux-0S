#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

CMD="${1:-}"
shift || true

case "$CMD" in
  health)
    ./scripts/healthcheck.sh
    ;;
  provision)
    APP="${1:-}"
    if [ -z "$APP" ]; then echo "Usage: citadel provision <app-slug>" >&2; exit 1; fi
    ./scripts/create-app-db.sh "$APP"
    ;;
  migrate)
    APP="${1:-}"
    DIR="${2:-}"
    if [ -z "$APP" ] || [ -z "$DIR" ]; then echo "Usage: citadel migrate <app-slug> <migration-dir>" >&2; exit 1; fi
    ./scripts/migrate.sh "$APP" "$DIR"
    ;;
  backup-now)
    ./scripts/backup-now.sh
    ;;
  backup-app)
    APP="${1:-}"
    if [ -z "$APP" ]; then echo "Usage: citadel backup-app <app-slug>" >&2; exit 1; fi
    ./scripts/backup-app.sh "$APP"
    ;;
  backup-encrypted)
    ./scripts/backup-encrypted.sh
    ;;
  restore-test)
    ./scripts/restore-test.sh
    ;;
  restore-app-test)
    APP="${1:-}"
    if [ -z "$APP" ]; then echo "Usage: citadel restore-app-test <app-slug>" >&2; exit 1; fi
    ./scripts/restore-app-test.sh "$APP"
    ;;
  smoke-all)
    ./scripts/smoke-all.sh
    ;;
  readiness)
    if [ -f .env ]; then set -a; source .env; set +a; fi
    curl -sS "http://127.0.0.1:${GATEWAY_PORT:-7313}/admin/readiness" -H "Authorization: Bearer ${GATEWAY_ADMIN_TOKEN:-}" | python3 -m json.tool
    ;;
  capacity)
    if [ -f .env ]; then set -a; source .env; set +a; fi
    curl -sS "http://127.0.0.1:${GATEWAY_PORT:-7313}/admin/capacity" -H "Authorization: Bearer ${GATEWAY_ADMIN_TOKEN:-}" | python3 -m json.tool
    ;;
  jobs)
    if [ -f .env ]; then set -a; source .env; set +a; fi
    curl -sS "http://127.0.0.1:${GATEWAY_PORT:-7313}/admin/jobs" -H "Authorization: Bearer ${GATEWAY_ADMIN_TOKEN:-}" | python3 -m json.tool
    ;;
  enqueue-job)
    JOB_TYPE="${1:-}"
    if [ -z "$JOB_TYPE" ]; then echo "Usage: citadel enqueue-job <job-type>" >&2; exit 1; fi
    if [ -f .env ]; then set -a; source .env; set +a; fi
    curl -sS -X POST "http://127.0.0.1:${GATEWAY_PORT:-7313}/admin/jobs"       -H "Authorization: Bearer ${GATEWAY_ADMIN_TOKEN:-}"       -H "Content-Type: application/json"       -d "{"jobType":"${JOB_TYPE}","requestedBy":"cli"}" | python3 -m json.tool
    ;;
  validate-env)
    ./scripts/validate-env.sh
    ;;
  object-backup-sync)
    ./reliquary/sync-object-backups.sh
    ;;
  policy-check)
    ./tools/policy-check.sh
    ;;
  backup-manifest)
    ./reliquary/generate-backup-manifest.sh
    ;;
  service-catalog-export)
    ./tools/export-service-catalog.sh
    ;;
  architecture-guard)
    ./tools/public-architecture-guard.sh
    ;;
  vps-preflight)
    ./scripts/vps-preflight.sh
    ;;
  route-contract-proof)
    ./tools/route-contract-proof.sh
    ;;
  express-async-error-proof)
    ./tools/express-async-error-proof.sh
    ;;
