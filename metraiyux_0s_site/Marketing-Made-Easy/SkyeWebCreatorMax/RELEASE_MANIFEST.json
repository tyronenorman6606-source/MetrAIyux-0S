{
  "product": "SkyeWebCreatorMax",
  "version": "0.1.0",
  "type": "standalone-pwa-plus-skyehands-platform-node",
  "entrypoints": [
    "landing.html",
    "index.html",
    "homepage.html",
    "offline.html"
  ],
  "runtimeFiles": [
    "js/webcreator.js",
    "js/skygate-client.js",
    "runtime/local-runtime.mjs",
    "runtime/store.json",
    "service-worker.js",
    "sw.js",
    "manifest.json",
    "manifest.webmanifest",
    "netlify.toml"
  ],
  "connectedBridge": "skyehands_runtime_control/core/webcreator/skyewebcreator-bridge.mjs",
  "platformBus": "skyehands_runtime_control/core/platform-bus/skyehands-platform-bus.mjs",
  "designVault": "design-vault/library",
  "smoke": [
    "smoke/smoke-release-checks.mjs",
    "smoke/smoke-browser.mjs",
    "smoke/smoke-proof.mjs",
    "smoke/smoke-production-readiness.mjs",
    "skyehands_runtime_control/scripts/smoke-skyewebcreator-bridge.mjs"
  ],
  "envContract": "config/env.contract.json",
  "gateway": {
    "canonical": "FS27/SkyGate/Free99 shared 0S gate",
    "eventMirror": "/api/skygate/platform-event",
    "aiGateway": "/api/marketing-made-easy/webcreator-runtime/auren",
    "appClientAuth": "/gate/signup/"
  },
  "runtimeBoundary": {
    "staticEndpointFiles": "Route contracts only; not live telemetry or customer visibility.",
    "liveWorkerRuntime": "/api/marketing-made-easy/webcreator-runtime/*",
    "localRuntime": "runtime/local-runtime.mjs is a same-folder proof harness, not production delivery proof.",
    "auth": "FS27/SkyGate/Free99 shared 0S gate only"
  },
  "productionReadinessRule": "Local smokes prove local package behavior only. Production readiness also requires shared-gated Worker runtime proof for live telemetry, customer visibility, and delivery handoff claims."
}
