# Skyes Over London three-site SEO network deployment/tracking template
# Copy this file to .env.deploy and fill only the values you actually use.
# Leave unused tools blank. Do not commit private account passwords or API secrets.

# Canonical live domains after deployment. Use full https:// URLs with no trailing slash.
SKYES_OVER_LONDON_URL=https://your-skyes-over-london-domain.com
SKYE_REVIEW_LAB_URL=https://your-skye-review-lab-domain.com
ARIZONA_GROWTH_INDEX_URL=https://your-arizona-growth-index-domain.com

# Google Analytics 4. Format normally looks like G-XXXXXXXXXX.
# Controls page views, traffic sources, events, form-submit attempts, conversion clicks.
GA4_MEASUREMENT_ID=

# Google Search Console site verification token.
# Controls proof to Google that you own the site so you can see indexing/search performance.
GOOGLE_SEARCH_CONSOLE_VERIFICATION_TOKEN=

# Bing Webmaster Tools verification token.
# Controls proof to Bing/Microsoft that you own the site so you can submit sitemaps and inspect Bing search performance.
BING_WEBMASTER_VERIFICATION_TOKEN=

# Microsoft Clarity. Project ID comes from the Clarity project setup screen.
# Controls heatmaps, session recordings, rage clicks/dead clicks, and UX behavior reports.
CLARITY_PROJECT_ID=

# Meta Pixel. Numeric pixel ID from Meta Events Manager.
# Controls Facebook/Instagram ad retargeting, ad optimization, and conversion reporting.
META_PIXEL_ID=

# Google Ads conversion tracking. Only needed if running Google Ads.
# GOOGLE_ADS_CONVERSION_ID usually looks like AW-123456789.
# GOOGLE_ADS_LEAD_CONVERSION_LABEL is the label for a lead/form/click conversion action.
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_LEAD_CONVERSION_LABEL=

# Optional: turn tracking injection on/off when generating deployment config.
ENABLE_GA4=true
ENABLE_SEARCH_CONSOLE=true
ENABLE_BING_WEBMASTER=true
ENABLE_CLARITY=true
ENABLE_META_PIXEL=false
ENABLE_GOOGLE_ADS=false

SKYES_AUTHORITY_URL=https://YOUR-SKYES-DOMAIN.com
GOOGLE_SEARCH_CONSOLE_TOKEN=YOUR_GOOGLE_SITE_VERIFICATION_TOKEN
BING_WEBMASTER_TOKEN=YOUR_BING_SITE_VERIFICATION_TOKEN
MICROSOFT_CLARITY_ID=YOUR_CLARITY_PROJECT_ID
GOOGLE_ADS_CONVERSION_LABEL=YOUR_CONVERSION_LABEL
SKYGATE_INTEGRATION_MODE=external-auth-inherits-later

# Founder Console v6 protection
# Use these for npm run serve:secure and Cloudflare Pages Functions middleware.
FOUNDER_CONSOLE_USER=founder
FOUNDER_CONSOLE_PASSWORD=replace_with_long_password
