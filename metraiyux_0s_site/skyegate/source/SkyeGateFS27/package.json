{
  "name": "skygatefs27-citadeldb",
  "version": "5.0.0-fs27-citadeldb-auth-bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run validate:env && npm run sync:env-website",
    "integrate:app": "node ./scripts/scaffold-app-into-skygate.mjs",
    "smoke:proof": "node ./smoke/smoke-proof.mjs",
    "verify:skins": "node ./scripts/verify-skins.mjs",
    "validate:env": "node ./scripts/validate-env-ultimate.mjs",
    "sync:env-website": "node ./scripts/sync-env-website.mjs",
    "deploy:hook": "node ./scripts/trigger-netlify-build-hook.mjs",
    "env:update": "npm run build && npm run deploy:hook",
    "audit:consumers": "node ./scripts/audit-consumer-adoption.mjs",
    "proof:skyepay": "node ../../../../tools/browser-proof-disabled.mjs --lane=fs27-skyepay-browser-proof",
    "test:skyepay:owner-approval": "node ./scripts/skyepay-owner-approval-regression.mjs",
    "test:skyepay:auto-unlock": "node ./scripts/skyepay-owner-approval-regression.mjs",
    "test:runtime-observer": "node --test ./tests/runtime-observer.test.mjs",
    "test:skynet-deploy-api": "node --test ./tests/skynet-deploy-api.test.mjs",
    "proof:skyepay:live": "node ../../../../tools/browser-proof-disabled.mjs --lane=fs27-skyepay-live-browser-proof",
    "proof:skyepay:live-catalog-checkout": "node ./scripts/skyepay-live-catalog-checkout-proof.mjs",
    "proof:skyepay:public-buy-links": "node ./scripts/skyepay-public-buy-link-proof.mjs",
    "dev:skyepay": "node ./scripts/skyepay-dev-server.mjs",
    "prod:skyepay:db": "node ./scripts/bootstrap-skyepay-db.mjs",
    "prod:skyepay:env": "node ./scripts/sync-skyepay-production-env.mjs",
    "prod:skysecure:env": "node ./scripts/sync-skysecure-production-env.mjs",
    "sync:cloudflare-assets": "node ./scripts/sync-cloudflare-assets.mjs",
    "check:worker": "node --check ./cloudflare/runtime-observer.mjs && node --check ./cloudflare/skynet-deploy-api.mjs && node --check ./cloudflare/worker.mjs",
    "deploy:worker": "npm run sync:cloudflare-assets && npx --yes wrangler@4.95.0 deploy",
    "deploy:worker:dry-run": "npm run sync:cloudflare-assets && npx --yes wrangler@4.95.0 deploy --dry-run --outdir /tmp/fs27-worker-dry-run",
    "proof:pin-auth": "node ./scripts/pin-auth-source-proof.mjs",
    "proof:skyepay:buyer-truth": "node ./scripts/skyepay-buyer-fulfillment-truth-proof.mjs",
    "proof:skyepay:sales-registry": "node ./scripts/skyepay-sales-registry-money-lane-proof.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "10.4.1",
    "@netlify/neon": "0.1.2",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.36.2",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "stripe": "20.3.1",
    "yauzl": "2.10.0"
  }
}
