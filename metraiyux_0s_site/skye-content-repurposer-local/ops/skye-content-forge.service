[Unit]
Description=Skye Content Forge always-on publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/skye-content-forge
Environment=NODE_ENV=production
Environment=PROCESS_MANAGER=systemd
Environment=PUBLISHER_AUTORUN=1
Environment=PUBLISHER_POLL_SECONDS=300
EnvironmentFile=/opt/skye-content-forge/.env
ExecStart=/usr/bin/node /opt/skye-content-forge/server.js
Restart=always
RestartSec=8
User=skye
Group=skye
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/skye-content-forge/data /opt/skye-content-forge/exports /opt/skye-content-forge/site-build

[Install]
WantedBy=multi-user.target
