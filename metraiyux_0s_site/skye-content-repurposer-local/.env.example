# Skye Content Forge V4 configuration
PORT=4313
APP_NAME=Skye Content Forge
COMPANY_NAME=Skyes Over London
NODE_ENV=production
PROCESS_MANAGER=node

# Lock the live dashboard and protected write endpoints.
# Use long random values. Store APP_ACCESS_TOKEN in the dashboard token box.
APP_ACCESS_TOKEN=<dashboard-access-token>
SCHEDULER_API_KEY=<scheduler-api-key>
APP_BASE_URL=https://your-live-app-domain.example.com

# OpenAI Responses API
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-5.4-mini

# Local/server-side persistence. Relative paths are resolved from this app folder.
PERSISTENCE_MODE=json-files-plus-optional-github-backup
EXPORT_DIR=exports
STATIC_SITE_DIR=site-build

# Publisher / scheduler
# PUBLISHER_AUTORUN runs due queue processing while the server process is alive.
# External schedulers should also call /api/automation/tick so automation survives laptop shutdowns.
PUBLISHER_AUTORUN=1
PUBLISHER_POLL_SECONDS=300
BACKUP_TO_GITHUB_ON_TICK=1
PUBLIC_BLOG_BASE_URL=https://your-domain.com
SOCIAL_DEFAULT_CTA=Book a Skyes Over London AI, website, and search visibility audit.

# Optional Google Drive upload.
# Create a Google Cloud service account, enable Google Drive API,
# share the target Drive folder with the service account email, then paste values here.
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="<escaped-google-service-account-private-key>"
GOOGLE_DRIVE_EXPORT_PREFIX=Skye Content Forge -

# GitHub content publishing + GitHub backup/recovery.
# Fine-grained token should have repo contents read/write for this repo.
GITHUB_TOKEN=<github-token>
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-content-or-site-repo
GITHUB_BRANCH=main
GITHUB_CONTENT_DIR=content/blog
GITHUB_BACKUP_BRANCH=main
GITHUB_BACKUP_DIR=skye-content-forge-backups

# Netlify deployment.
# Best architecture: GitHub commit triggers the connected Netlify site.
# Optional: deploy hook manually triggers a build for Git-connected Netlify sites.
NETLIFY_DEPLOY_HOOK_URL=https://api.netlify.com/build_hooks/your-hook-id
# Optional direct CLI deploy from local static build folder.
NETLIFY_AUTH_TOKEN=<netlify-token>
NETLIFY_SITE_ID=your-netlify-site-id

# Cloudflare Pages deployment.
# Best architecture: GitHub commit triggers the connected Cloudflare Pages project.
# Optional: deploy hook manually triggers a build.
CLOUDFLARE_PAGES_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/your-hook-id
# Optional direct Wrangler deploy from local static build folder.
CLOUDFLARE_API_TOKEN=<cloudflare-api-token>
CLOUDFLARE_PAGES_PROJECT_NAME=your-pages-project-name
CLOUDFLARE_PAGES_BRANCH=main

# Meta / Facebook / Instagram official API publishing.
# Requires a Meta app, permissions, business/page access, and valid long-lived token.
META_GRAPH_API_VERSION=v25.0
META_PAGE_ACCESS_TOKEN=<meta-page-access-token>
FACEBOOK_PAGE_ID=your-facebook-page-id
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
# Instagram publishing requires a publicly reachable image/video URL. Text-only Instagram feed posts are not supported.
INSTAGRAM_DEFAULT_IMAGE_URL=https://your-domain.com/social/default-image.jpg

# LinkedIn official publishing.
# Requires LinkedIn app access and posting permissions.
LINKEDIN_ACCESS_TOKEN=<linkedin-access-token>
LINKEDIN_AUTHOR_URN=urn:li:organization:123456789
LINKEDIN_VISIBILITY=PUBLIC
